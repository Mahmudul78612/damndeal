{
  "name": "damndeal-delivery",
  "version": "1.0.0",
  "description": "DamnDeal Delivery Partner Android App",
  "main": "index.html",
  "scripts": {
    "build": "echo 'Static app - no build step needed'",
    "cap:init": "npx cap init \"DamnDeal Delivery\" com.damndeal.delivery --web-dir .",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:build": "npx cap sync android && cd android && .\\gradlew assembleDebug",
    "apk": "npm run cap:sync && cd android && .\\gradlew assembleDebug && echo APK ready at android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
