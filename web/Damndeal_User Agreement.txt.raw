ent or applicable laws;</w:t></w:r></w:p><w:p w14:paraId="68282F83" w14:textId="529CA551" w:rsidR="007262BD" w:rsidRPr="007262BD" w:rsidRDefault="007262BD" w:rsidP="007262BD"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Your violation of any third-party rights.</w:t></w:r></w:p><w:p w14:paraId="56B09E43" w14:textId="2262B5A9" w:rsidR="007262BD" w:rsidRDefault="00032F6C" w:rsidP="0043740D"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r w:rsidRPr="00032F6C"><w:t>SUSPENSION AND TERMINATION</w:t></w:r></w:p><w:p w14:paraId="057C1637" w14:textId="56C391AC" w:rsidR="00032F6C" w:rsidRDefault="00032F6C" w:rsidP="00032F6C"><w:pPr><w:pStyle w:val="Heading2"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="0"/></w:numPr></w:pPr><w:proofErr w:type="spellStart"/><w:r><w:t>Damndeal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> reserves the right to suspend, restrict, or permanently terminate Your account without notice if:</w:t></w:r></w:p><w:p w14:paraId="046CDC5A" w14:textId="77777777" w:rsidR="00032F6C" w:rsidRDefault="00032F6C" w:rsidP="00032F6C"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>You breach any provisions of this Agreement or other policies;</w:t></w:r></w:p><w:p w14:paraId="554D769E" w14:textId="77777777" w:rsidR="00032F6C" w:rsidRDefault="00032F6C" w:rsidP="00032F6C"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>You are involved in fraudulent activity or misuse of the Platform;</w:t></w:r></w:p><w:p w14:paraId="18855920" w14:textId="77777777" w:rsidR="00032F6C" w:rsidRDefault="00032F6C" w:rsidP="00032F6C"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Required by law enforcement or court orders.</w:t></w:r></w:p><w:p w14:paraId="27231349" w14:textId="77777777" w:rsidR="00032F6C" w:rsidRDefault="00032F6C" w:rsidP="00032F6C"><w:pPr><w:pStyle w:val="Heading2"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="0"/></w:numPr></w:pPr><w:r><w:lastRenderedPageBreak/><w:t>Termination of this Agreement shall not affect any rights or obligations accrued prior to termination.</w:t></w:r></w:p><w:p w14:paraId="7129FDAC" w14:textId="19C5DCB4" w:rsidR="003F4788" w:rsidRPr="001F6DAA" w:rsidRDefault="003F4788" w:rsidP="0043740D"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r w:rsidRPr="001F6DAA"><w:t>Governing Law &amp; Dispute Resolution</w:t></w:r></w:p><w:p w14:paraId="73FF7E2C" w14:textId="6288C77B" w:rsidR="003F4788" w:rsidRPr="001F6DAA" w:rsidRDefault="003F4788" w:rsidP="001A7E40"><w:pPr><w:spacing w:before="120" w:after="120"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr><w:r w:rsidRPr="001F6DAA"><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">This Policy shall be governed by and construed in accordance with the laws of India. Any disputes arising out of or relating to this Policy shall be subject to the exclusive jurisdiction of the courts located in </w:t></w:r><w:r w:rsidR="00852D2D" w:rsidRPr="001F6DAA"><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>Patiala, Punjab</w:t></w:r><w:r w:rsidR="00C46359" w:rsidRPr="001F6DAA"><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:r w:rsidRPr="001F6DAA"><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>India.</w:t></w:r><w:r w:rsidR="007E3089" w:rsidRPr="001F6DAA"><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="001F6DAA"><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><