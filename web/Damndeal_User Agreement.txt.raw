w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr><w:r w:rsidRPr="001F6DAA"><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>To qualify for participation in the Reward Program, a user must:</w:t></w:r></w:p><w:p w14:paraId="308BA79A" w14:textId="77777777" w:rsidR="003F4788" w:rsidRPr="001F6DAA" w:rsidRDefault="003F4788" w:rsidP="00492F72"><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:r w:rsidRPr="001F6DAA"><w:t xml:space="preserve">Be a registered </w:t></w:r><w:r w:rsidRPr="00492F72"><w:t>customer</w:t></w:r><w:r w:rsidRPr="001F6DAA"><w:t xml:space="preserve"> on the </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="001F6DAA"><w:t>Damndeal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="001F6DAA"><w:t xml:space="preserve"> platform.</w:t></w:r></w:p><w:p w14:paraId="1A7FE96A" w14:textId="77777777" w:rsidR="003F4788" w:rsidRPr="001F6DAA" w:rsidRDefault="003F4788" w:rsidP="00A614D5"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr><w:spacing w:before="120" w:after="120"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr><w:r w:rsidRPr="001F6DAA"><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>Make a qualifying purchase through the website or mobile application.</w:t></w:r></w:p><w:p w14:paraId="481CDC19" w14:textId="17DE4013" w:rsidR="003F4788" w:rsidRPr="001F6DAA" w:rsidRDefault="003F4788" w:rsidP="00A614D5"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr><w:spacing w:before="120" w:after="120"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr><w:r w:rsidRPr="001F6DAA"><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">Ensure that the purchased product is neither </w:t></w:r><w:r w:rsidR="00550306" w:rsidRPr="001F6DAA"><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>cancelled</w:t></w:r><w:r w:rsidRPr="001F6DAA"><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>, returned, nor refunded.</w:t></w:r></w:p><w:p w14:paraId="766C33F5" w14:textId="77777777" w:rsidR="003F4788" w:rsidRPr="001F6DAA" w:rsidRDefault="003F4788" w:rsidP="00A614D5"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr><w:spacing w:before="120" w:after="120"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr><w:r w:rsidRPr="001F6DAA"><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>Comply with the platform’s policies and fair usage conditions.</w:t></w:r></w:p><w:p w14:paraId="45681A55" w14:textId="594093DC" w:rsidR="003F4788" w:rsidRPr="001F6DAA" w:rsidRDefault="00531C41" w:rsidP="006E684A"><w:pPr><w:pStyle w:val="Heading1"/><w:keepNext/><w:keepLines/></w:pPr><w:r w:rsidRPr="00531C41"><w:lastRenderedPageBreak/><w:t>ABOUT DAMNDEAL</w:t></w:r></w:p><w:p w14:paraId="7D25495A" w14:textId="7CD17561" w:rsidR="003F4788" w:rsidRPr="00237082" w:rsidRDefault="00237082" w:rsidP="0043740D"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00237082"><w:t>Damndeal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00237082"><w:t xml:space="preserve"> is an online marketplace that facilitates the listing and sale of goods by independent third-party sellers (“Vendors”) to Users. The Platform enables Users to browse, purchase, and receive products sold by such Vendors</w:t></w:r><w:r w:rsidRPr="00237082"><w:t>.</w:t></w:r></w:p><w:p w14:paraId="72AF96AC" w14:textId="77777777" w:rsidR="00237082" w:rsidRPr="00237082" w:rsidRDefault="00237082" w:rsidP="00237082"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00237082"><w:t>Damndeal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00237082"><w:t xml:space="preserve"> is not a manufacturer, distributor, or seller of products. </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00237082"><w:t>Damndeal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00237082"><w:t xml:space="preserve"> is merely an intermediary as defined under Section 2(1)(w) of the Information Technology Act, </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00237082"><w:t>2000, and</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="00237082"><w:t xml:space="preserve"> is not a party to the transaction between the User and the Vendor.</w:t></w:r></w:p><w:p w14:paraId="1834B051" w14:textId="7AEC227B" w:rsidR="003F4788" w:rsidRPr="00237082" w:rsidRDefault="00237082" w:rsidP="00237082"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r w:rsidRPr="00237082"><w:t>All warranties, guarantees, after-sales services, statutory compliances, and product liabilities rest solely with the Vendor.</w:t></w:r></w:p><w:p w14:paraId="5E636E41" w14:textId="25AADD77" w:rsidR="003F4788" w:rsidRPr="001F6DAA" w:rsidRDefault="009D14BB" w:rsidP="0043740D"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r w:rsidRPr="009D14BB"><w:t>ACCOUNT REGISTRATION AND SECURITY</w:t></w:r></w:p><w:p w14:paraId="62C157F4" w14:textId="77777777" w:rsidR="009D14BB" w:rsidRPr="009D14BB" w:rsidRDefault="009D14BB" w:rsidP="009D14BB"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r w:rsidRPr="009D14BB"><w:t>To access certain features of the Platform, You must create an account using a valid email address, phone number, and any other details as required.</w:t></w:r></w:p><w:p w14:paraId="047D72D7" w14:textId="363CB476" w:rsidR="009D14BB" w:rsidRPr="009D14BB" w:rsidRDefault="009D14BB" w:rsidP="009D14BB"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r w:rsidRPr="009D14BB"><w:t>You are solely responsible for maintaining the confidentiality of Your account credentials and for all activities that occur under Your account.</w:t></w:r></w:p><w:p w14:paraId="4874B444" w14:textId="33FB78DB" w:rsidR="003F4788" w:rsidRPr="009D14BB" w:rsidRDefault="009D14BB" w:rsidP="009D14BB"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="009D14BB"><w:t>Damndeal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="009D14BB"><w:t xml:space="preserve"> shall not be liable for any loss or damage arising from unauthorized use of Your account. You agree to notify Us immediately if You suspect any breach of security or unauthorized access.</w:t></w:r></w:p><w:p w14:paraId="3622C070" w14:textId="28AB3C66" w:rsidR="003F4788" w:rsidRPr="001F6DAA" w:rsidRDefault="00887173" w:rsidP="0043740D"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r w:rsidRPr="00887173"><w:t>PURCHASES AND PAYMENTS</w:t></w:r></w:p><w:p w14:paraId="08D47C4E" w14:textId="77777777" w:rsidR="00887173" w:rsidRPr="00887173" w:rsidRDefault="00887173" w:rsidP="00887173"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r w:rsidRPr="00887173"><w:t>You may place an order for products listed by Vendors on the Platform. Such an order constitutes an offer to purchase, which is subject to Vendor acceptance.</w:t></w:r></w:p><w:p w14:paraId="6662D5FB" w14:textId="57091C7A" w:rsidR="00887173" w:rsidRPr="00887173" w:rsidRDefault="00887173" w:rsidP="00887173"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r w:rsidRPr="00887173"><w:t xml:space="preserve">All prices displayed are inclusive of applicable taxes unless otherwise stated. </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00887173"><w:t>Damndeal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00887173"><w:t xml:space="preserve"> reserves the right to correct pricing errors at any time.</w:t></w:r></w:p><w:p w14:paraId="40F283D3" w14:textId="1396556E" w:rsidR="00887173" w:rsidRPr="00887173" w:rsidRDefault="00887173" w:rsidP="00887173"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r w:rsidRPr="00887173"><w:t xml:space="preserve">Payment must be made at the time of placing the order, via payment gateways approved by </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00887173"><w:t>Damndeal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00887173"><w:t>.</w:t></w:r></w:p><w:p w14:paraId="250E10D3" w14:textId="09582007" w:rsidR="003F4788" w:rsidRPr="001F6DAA" w:rsidRDefault="00887173" w:rsidP="00887173"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r w:rsidRPr="00887173"><w:t xml:space="preserve">Once an order is placed and confirmed, a binding contract is formed between You and the Vendor. </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00887173"><w:t>Damndeal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00887173"><w:t xml:space="preserve"> shall not be liable for failure or delays in Vendor performance, including product delivery or defects</w:t></w:r><w:r w:rsidR="002D5D62" w:rsidRPr="001F6DAA"><w:t>.</w:t></w:r></w:p><w:p w14:paraId="790C93D4" w14:textId="2C5EC703" w:rsidR="003F4788" w:rsidRPr="001F6DAA" w:rsidRDefault="00452CB6" w:rsidP="0043740D"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r w:rsidRPr="00452CB6"><w:t>ORDER FULFILLMENT AND DELIVERY</w:t></w:r></w:p><w:p w14:paraId="1F830C79" w14:textId="77777777" w:rsidR="00452CB6" w:rsidRDefault="00452CB6" w:rsidP="00452CB6"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">All orders are fulfilled directly by the Vendors. </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Damndeal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> does not hold inventory or deliver products.</w:t></w:r></w:p><w:p w14:paraId="7E7AD548" w14:textId="3A95D424" w:rsidR="00452CB6" w:rsidRDefault="00452CB6" w:rsidP="00452CB6"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Delivery timelines indicated on the Platform are estimates provided by the Vendors. Delays may occur due to unforeseen logistics or supply chain disruptions.</w:t></w:r></w:p><w:p w14:paraId="7CF976EA" w14:textId="6CE22441" w:rsidR="003F4788" w:rsidRPr="001F6DAA" w:rsidRDefault="00452CB6" w:rsidP="00452CB6"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Risk of loss or damage to goods shall pass to You upon delivery to the shipping carrier.</w:t></w:r></w:p><w:p w14:paraId="2202D873" w14:textId="02FC200D" w:rsidR="00B6351E" w:rsidRDefault="00B6351E" w:rsidP="0043740D"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r w:rsidRPr="00B6351E"><w:t>RETURNS, REFUNDS, AND CANCELLATIONS</w:t></w:r></w:p><w:p w14:paraId="318330E9" w14:textId="1E96A1CF" w:rsidR="00B6351E" w:rsidRDefault="00B6351E" w:rsidP="00B6351E"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Users may initiate a return or refund request only in accordance with the </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Damndeal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> Refund Policy, which forms an integral part of this Agreement.</w:t></w:r></w:p><w:p w14:paraId="18BDFBDE" w14:textId="13CA4E8E" w:rsidR="00B6351E" w:rsidRDefault="00B6351E" w:rsidP="00B6351E"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Refunds shall only be issued in the following cases:</w:t></w:r></w:p><w:p w14:paraId="40F414F9" w14:textId="77777777" w:rsidR="00B6351E" w:rsidRDefault="00B6351E" w:rsidP="00B6351E"><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:r><w:t>Product received is defective, damaged, or materially different from its description;</w:t></w:r></w:p><w:p w14:paraId="0A2C4B5C" w14:textId="77777777" w:rsidR="00B6351E" w:rsidRDefault="00B6351E" w:rsidP="00B6351E"><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:r><w:t>Order was not delivered within the promised timeframe;</w:t></w:r></w:p><w:p w14:paraId="053FD08B" w14:textId="77777777" w:rsidR="00B6351E" w:rsidRDefault="00B6351E" w:rsidP="00B6351E"><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:r><w:lastRenderedPageBreak/><w:t>Product falls within the category of eligible returns.</w:t></w:r></w:p><w:p w14:paraId="5D22B0F9" w14:textId="53345495" w:rsidR="00B6351E" w:rsidRDefault="00B6351E" w:rsidP="00B6351E"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Cancellations are permitted only before order processing. Once dispatched, orders can no longer be cancelled and must go through the return process.</w:t></w:r></w:p><w:p w14:paraId="7594BBBC" w14:textId="199DBE69" w:rsidR="00B6351E" w:rsidRPr="00B6351E" w:rsidRDefault="00B6351E" w:rsidP="00B6351E"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Refunds are typically processed within 7–10 business days, depending on payment method and bank processing times.</w:t></w:r></w:p><w:p w14:paraId="00BA0A72" w14:textId="3DA05A28" w:rsidR="00B6351E" w:rsidRDefault="00F261F1" w:rsidP="0043740D"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r w:rsidRPr="00F261F1"><w:t>REWARD PROGRAM</w:t></w:r></w:p><w:p w14:paraId="5D3661BB" w14:textId="6B809590" w:rsidR="00F261F1" w:rsidRDefault="00F261F1" w:rsidP="00F261F1"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:proofErr w:type="spellStart"/><w:r><w:t>Damndeal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> offers a Reward Program where eligible purchases may earn Users rewards based on automatic grouping (“clubbing”) of orders with other users. This process is entirely algorithm-driven and may result in reward credit of up to 1% of the total value of the clubbed purchases.</w:t></w:r></w:p><w:p w14:paraId="3FB73ABB" w14:textId="3EF6A089" w:rsidR="00F261F1" w:rsidRDefault="00F261F1" w:rsidP="00F261F1"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">When a User refers another individual (“Referred User”), and that Referred User makes a qualifying purchase, their order will be automatically clubbed with the referring User’s order unless </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Damndeal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> decides otherwise at its sole discretion.</w:t></w:r></w:p><w:p w14:paraId="1AB282CA" w14:textId="4E069400" w:rsidR="00F261F1" w:rsidRDefault="00F261F1" w:rsidP="00F261F1"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Any order that is returned, cancelled, or refunded will not be eligible to receive any rewards.</w:t></w:r></w:p><w:p w14:paraId="387D733C" w14:textId="6D68984B" w:rsidR="00F261F1" w:rsidRDefault="00F261F1" w:rsidP="00F261F1"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Rewards will be credited in the form of wallet credits and can be used only for future purchases on the Platform. Rewards are non-transferable, non-redeemable for cash, and subject to expiry.</w:t></w:r></w:p><w:p w14:paraId="3FBAA202" w14:textId="60A75C59" w:rsidR="00F261F1" w:rsidRDefault="00F261F1" w:rsidP="00F261F1"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Detailed terms of participation, eligibility, and fraud prevention are provided in the </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Damndeal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> Reward Policy, which is hereby incorporated by reference.</w:t></w:r></w:p><w:p w14:paraId="6CAE19CB" w14:textId="01E6F700" w:rsidR="00F261F1" w:rsidRDefault="00121EFA" w:rsidP="0043740D"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r w:rsidRPr="00121EFA"><w:t>USER CONDUCT</w:t></w:r></w:p><w:p w14:paraId="7C7D6B80" w14:textId="77777777" w:rsidR="00121EFA" w:rsidRDefault="00121EFA" w:rsidP="00D531C8"><w:pPr><w:pStyle w:val="Heading2"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="0"/></w:numPr></w:pPr><w:r><w:t>You agree that You shall not:</w:t></w:r></w:p><w:p w14:paraId="68ABA985" w14:textId="77777777" w:rsidR="00121EFA" w:rsidRDefault="00121EFA" w:rsidP="00121EFA"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Post, upload, or transmit any content that is unlawful, fraudulent, defamatory, or harmful;</w:t></w:r></w:p><w:p w14:paraId="5A796CAD" w14:textId="77777777" w:rsidR="00121EFA" w:rsidRDefault="00121EFA" w:rsidP="00121EFA"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Violate any third-party rights, including intellectual property, confidentiality, or publicity rights;</w:t></w:r></w:p><w:p w14:paraId="7FCEFC46" w14:textId="77777777" w:rsidR="00121EFA" w:rsidRDefault="00121EFA" w:rsidP="00121EFA"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Interfere with or disrupt the functioning of the Platform or servers;</w:t></w:r></w:p><w:p w14:paraId="629D194E" w14:textId="747BBD44" w:rsidR="00121EFA" w:rsidRDefault="00121EFA" w:rsidP="00121EFA"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Use the Platform for any purpose other than purchasing products for personal consumption;</w:t></w:r></w:p><w:p w14:paraId="3FE0C397" w14:textId="77777777" w:rsidR="00121EFA" w:rsidRDefault="00121EFA" w:rsidP="00121EFA"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Attempt to gain unauthorized access to any systems, user accounts, or data;</w:t></w:r></w:p><w:p w14:paraId="4FF5C711" w14:textId="77777777" w:rsidR="00121EFA" w:rsidRDefault="00121EFA" w:rsidP="00121EFA"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Misuse the Reward Program or Referral System through artificial transactions or multiple accounts.</w:t></w:r></w:p><w:p w14:paraId="1ECCFB4E" w14:textId="18B24C79" w:rsidR="00121EFA" w:rsidRPr="00121EFA" w:rsidRDefault="00121EFA" w:rsidP="00D531C8"><w:pPr><w:pStyle w:val="Heading2"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="0"/></w:numPr></w:pPr><w:r><w:t>Violation of these provisions may result in account termination, forfeiture of rewards, and legal action.</w:t></w:r></w:p><w:p w14:paraId="7FA23E90" w14:textId="18ACB811" w:rsidR="00110CBA" w:rsidRDefault="00110CBA" w:rsidP="0043740D"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r w:rsidRPr="00110CBA"><w:t>INTELLECTUAL PROPERTY</w:t></w:r></w:p><w:p w14:paraId="0E24106F" w14:textId="77777777" w:rsidR="00110CBA" w:rsidRDefault="00110CBA" w:rsidP="00110CBA"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">All content on the Platform, including logos, images, videos, text, software, and code, is the intellectual property of </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Damndeal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> or its licensors and is protected under Indian and international copyright and trademark laws.</w:t></w:r></w:p><w:p w14:paraId="7B46E77C" w14:textId="78584961" w:rsidR="00110CBA" w:rsidRDefault="00110CBA" w:rsidP="00110CBA"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">You may not copy, reproduce, modify, distribute, or exploit any content for commercial purposes without express written permission from </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Damndeal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t>.</w:t></w:r></w:p><w:p w14:paraId="20E49470" w14:textId="41C6B908" w:rsidR="00110CBA" w:rsidRDefault="00462747" w:rsidP="0043740D"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r w:rsidRPr="00462747"><w:lastRenderedPageBreak/><w:t>PRIVACY AND DATA USE</w:t></w:r></w:p><w:p w14:paraId="32CF54F2" w14:textId="7F2D9A9C" w:rsidR="00462747" w:rsidRDefault="00462747" w:rsidP="00462747"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve"> Your use of the Platform is subject to the </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Damndeal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> Privacy Policy, which outlines how Your personal data is collected, used, and shared in accordance with the Information Technology (Reasonable Security Practices and Procedures and Sensitive Personal Data or Information) Rules, 2011.</w:t></w:r></w:p><w:p w14:paraId="68AAC26B" w14:textId="1BFCB852" w:rsidR="00462747" w:rsidRPr="00462747" w:rsidRDefault="00462747" w:rsidP="00462747"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>By using the Platform, You consent to the collection and processing of Your data as described in the Privacy Policy.</w:t></w:r></w:p><w:p w14:paraId="7C8DDA01" w14:textId="721FA1AD" w:rsidR="00E53343" w:rsidRDefault="00E53343" w:rsidP="0043740D"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r w:rsidRPr="00E53343"><w:t>DISCLAIMER OF WARRANTIES</w:t></w:r></w:p><w:p w14:paraId="1B28C770" w14:textId="77777777" w:rsidR="00E53343" w:rsidRDefault="00E53343" w:rsidP="00E53343"><w:pPr><w:pStyle w:val="Heading2"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="0"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">The Platform and all content, features, and services are provided on an “as is” and “as available” basis. </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Damndeal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> makes no warranties or representations regarding the quality, fitness, or merchantability of the products sold by Vendors.</w:t></w:r></w:p><w:p w14:paraId="3F53A312" w14:textId="77777777" w:rsidR="00E53343" w:rsidRDefault="00E53343" w:rsidP="00E53343"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:proofErr w:type="spellStart"/><w:r><w:t>Damndeal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> disclaims all liability arising out of:</w:t></w:r></w:p><w:p w14:paraId="55B03935" w14:textId="77777777" w:rsidR="00E53343" w:rsidRDefault="00E53343" w:rsidP="00E53343"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Product defects or damages;</w:t></w:r></w:p><w:p w14:paraId="72E6AB38" w14:te