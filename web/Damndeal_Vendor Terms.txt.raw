></w:p><w:p w14:paraId="635DFFF4" w14:textId="21F86B3F" w:rsidR="00441582" w:rsidRPr="00441582" w:rsidRDefault="00441582" w:rsidP="00441582"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:lastRenderedPageBreak/><w:t xml:space="preserve">Upon termination, You must </w:t></w:r><w:r w:rsidR="000F5D2C"><w:t>fulfil</w:t></w:r><w:r><w:t xml:space="preserve"> all pending Orders and settle all financial obligations.</w:t></w:r></w:p><w:p w14:paraId="7129FDAC" w14:textId="79061755" w:rsidR="003F4788" w:rsidRPr="001F6DAA" w:rsidRDefault="003F4788" w:rsidP="008836CE"><w:pPr><w:pStyle w:val="Heading1"/><w:keepNext/><w:keepLines/></w:pPr><w:r w:rsidRPr="001F6DAA"><w:t>Governing Law &amp; Dispute Resolution</w:t></w:r></w:p><w:p w14:paraId="73FF7E2C" w14:textId="6288C77B" w:rsidR="003F4788" w:rsidRPr="001F6DAA" w:rsidRDefault="003F4788" w:rsidP="001A7E40"><w:pPr><w:spacing w:before="120" w:after="120"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr><w:r w:rsidRPr="001F6DAA"><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">This Policy shall be governed by and construed in accordance with the laws of India. Any disputes arising out of or relating to this Policy shall be subject to the exclusive jurisdiction of the courts located in </w:t></w:r><w:r w:rsidR="00852D2D" w:rsidRPr="001F6DAA"><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>Patiala, Punjab</w:t></w:r><w:r w:rsidR="00C46359" w:rsidRPr="001F6DAA"><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:r w:rsidRPr="001F6DAA"><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>India.</w:t></w:r><w:r w:rsidR="007E3089" w:rsidRPr="001F6DAA"><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="001F6DAA"><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">Users are encouraged to first reach out to </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="001F6DAA"><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>Damndeal’s</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="001F6DAA"><w:rPr><w:rFonts w:ascii="Verdana" w:hAnsi="Verdana" w:cs="Times New Roman"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve"> customer support team to seek an amicable resolution before initiating any legal proceedings.</w:t></w:r></w:p><w:p w14:paraId="19A0A991" w14:textId="1E3FD25C" w:rsidR="00C539F5" w:rsidRDefault="00C539F5" w:rsidP="00CB3F7E"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r w:rsidRPr="00C539F5"><w:t>AMENDMENTS</w:t></w:r></w:p><w:p w14:paraId="6B9777D8" w14:textId="77777777" w:rsidR="00C539F5" w:rsidRPr="00C539F5" w:rsidRDefault="00C539F5" w:rsidP="00C539F5"><w:pPr><w:pStyle w:val="Heading2"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="0"/></w:numPr></w:pPr><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00C539F5"><w:t>Damndeal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00C539F5"><w:t xml:space="preserve"> reserves the right to amend or modify this Agreement and related policies at any time. Continued use of the Platform by the Vendor shall constitute deemed acceptance of such revised terms.</w:t></w:r></w:p><w:p w14:paraId="0C45ED16" w14:textId="30FA9E89" w:rsidR="003F4788" w:rsidRPr="001F6DAA" w:rsidRDefault="003F4788" w:rsidP="00CB3F7E"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr