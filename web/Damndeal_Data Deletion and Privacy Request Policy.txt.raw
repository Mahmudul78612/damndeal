00B847F5" w:rsidRDefault="00B847F5" w:rsidP="00B847F5"><w:pPr><w:spacing w:before="0" w:line="240" w:lineRule="auto"/><w:rPr><w:sz w:val="2"/><w:szCs w:val="2"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0AC4D76F" w14:textId="4D928BA2" w:rsidR="0054243D" w:rsidRPr="00E85834" w:rsidRDefault="00F0381D" w:rsidP="00495B58"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r w:rsidRPr="00F0381D"><w:t>Request Full Account Deletion</w:t></w:r></w:p><w:p w14:paraId="3C897C90" w14:textId="1C3B4A06" w:rsidR="0054243D" w:rsidRPr="00E85834" w:rsidRDefault="00F0381D" w:rsidP="0054243D"><w:pPr><w:rPr><w:lang w:val="en-US" w:eastAsia="en-IN"/></w:rPr></w:pPr><w:r w:rsidRPr="00F0381D"><w:rPr><w:lang w:val="en-US" w:eastAsia="en-IN"/></w:rPr><w:t>You may request the permanent deletion of your Damndeal account and all associated personal information.</w:t></w:r></w:p><w:p w14:paraId="0ED5A64E" w14:textId="77777777" w:rsidR="00163358" w:rsidRPr="00163358" w:rsidRDefault="00163358" w:rsidP="00163358"><w:pPr><w:pStyle w:val="Heading2"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00163358"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>How to Request:</w:t></w:r></w:p><w:p w14:paraId="3559AEAA" w14:textId="3D18261A" w:rsidR="00163358" w:rsidRPr="00163358" w:rsidRDefault="00163358" w:rsidP="00163358"><w:pPr><w:pStyle w:val="Heading3"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00163358"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t xml:space="preserve">Email us at </w:t></w:r><w:hyperlink r:id="rId11" w:history="1"><w:r w:rsidR="008B1AEB" w:rsidRPr="003645B6"><w:rPr><w:rStyle w:val="Hyperlink"/><w:lang w:val="en-US"/></w:rPr><w:t>info@damndeal.in</w:t></w:r></w:hyperlink><w:r w:rsidR="008B1AEB"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r></w:p><w:p w14:paraId="142A59C8" w14:textId="77777777" w:rsidR="00163358" w:rsidRPr="00163358" w:rsidRDefault="00163358" w:rsidP="00163358"><w:pPr><w:pStyle w:val="Heading3"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00163358"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Use the subject line: "Full Account Deletion Request – [Your Registered Email ID]"</w:t></w:r></w:p><w:p w14:paraId="50B5D403" w14:textId="77777777" w:rsidR="00163358" w:rsidRPr="00163358" w:rsidRDefault="00163358" w:rsidP="00163358"><w:pPr><w:pStyle w:val="Heading3"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00163358"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Include the following details:</w:t></w:r></w:p><w:p w14:paraId="31B6DF12" w14:textId="77777777" w:rsidR="00163358" w:rsidRPr="003674F4" w:rsidRDefault="00163358" w:rsidP="003674F4"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="15"/></w:numPr><w:ind w:left="1701" w:hanging="425"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="003674F4"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Your full name</w:t></w:r></w:p><w:p w14:paraId="2B8D64BB" w14:textId="77777777" w:rsidR="00163358" w:rsidRPr="003674F4" w:rsidRDefault="00163358" w:rsidP="003674F4"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="15"/></w:numPr><w:ind w:left="1701" w:hanging="425"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="003674F4"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Your registered email ID and mobile number</w:t></w:r></w:p><w:p w14:paraId="37490EE4" w14:textId="77777777" w:rsidR="00163358" w:rsidRPr="003674F4" w:rsidRDefault="00163358" w:rsidP="003674F4"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="15"/></w:numPr><w:ind w:left="1701" w:hanging="425"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="003674F4"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>A clear request to delete your entire account and personal data</w:t></w:r></w:p><w:p w14:paraId="525E23AF" w14:textId="7C601745" w:rsidR="00163358" w:rsidRPr="00163358" w:rsidRDefault="00163358" w:rsidP="00CE02BF"><w:pPr><w:pStyle w:val="Heading2"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00B614FB"><w:rPr><w:u w:val="single"/><w:lang w:val="en-US"/></w:rPr><w:t>Verification</w:t></w:r><w:r w:rsidRPr="00163358"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t xml:space="preserve">. </w:t></w:r><w:r w:rsidRPr="00163358"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>To protect your privacy and security, we may initiate a verification process to confirm your identity before processing the deletion.</w:t></w:r></w:p><w:p w14:paraId="474ECCE2" w14:textId="3BEE758F" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00495B58"><w:pPr><w:pStyle w:val="Heading2"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00B614FB"><w:rPr><w:u w:val="single"/><w:lang w:val="en-US"/></w:rPr><w:t>Processing</w:t></w:r><w:r><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t xml:space="preserve">. </w:t></w:r><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Upon successful verification, your account and related personal data will be deleted within a reasonable time or as required under applicable laws. You will be notified once the deletion is complete.</w:t></w:r></w:p><w:p w14:paraId="48BC2B7D" w14:textId="012B13DC" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00495B58"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r w:rsidRPr="00495B58"><w:t>Request Partial Data Deletion (Account Remains Active)</w:t></w:r></w:p><w:p w14:paraId="75DD3705" w14:textId="0BFE6563" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00495B58"><w:pPr><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t xml:space="preserve">You can request </w:t></w:r><w:r><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t xml:space="preserve">the </w:t></w:r><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>deletion of specific personal data without closing your Damndeal account.</w:t></w:r></w:p><w:p w14:paraId="5C032127" w14:textId="77777777" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00495B58"><w:pPr><w:pStyle w:val="Heading3"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Common examples include:</w:t></w:r></w:p><w:p w14:paraId="7F1BB838" w14:textId="77777777" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00495B58"><w:pPr><w:pStyle w:val="Heading3"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Removal of stored addresses</w:t></w:r></w:p><w:p w14:paraId="2B185012" w14:textId="77777777" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00495B58"><w:pPr><w:pStyle w:val="Heading3"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Deletion of saved payment methods</w:t></w:r></w:p><w:p w14:paraId="3825E19C" w14:textId="77777777" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00495B58"><w:pPr><w:pStyle w:val="Heading3"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Erasure of search or browsing history</w:t></w:r></w:p><w:p w14:paraId="415BE9CF" w14:textId="77777777" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00495B58"><w:pPr><w:pStyle w:val="Heading3"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:lastRenderedPageBreak/><w:t>Deletion of optional profile information</w:t></w:r></w:p><w:p w14:paraId="7F86ADF7" w14:textId="77777777" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00495B58"><w:pPr><w:pStyle w:val="Heading2"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>How to Request:</w:t></w:r></w:p><w:p w14:paraId="6CCCE420" w14:textId="219FF278" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00495B58"><w:pPr><w:pStyle w:val="Heading3"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t xml:space="preserve">Email us at </w:t></w:r><w:hyperlink r:id="rId12" w:history="1"><w:r w:rsidR="008B1AEB" w:rsidRPr="003B0490"><w:rPr><w:rStyle w:val="Hyperlink"/></w:rPr><w:t>info@damndeal.in</w:t></w:r></w:hyperlink><w:r w:rsidR="008B1AEB"><w:t xml:space="preserve"> </w:t></w:r></w:p><w:p w14:paraId="5D860CF9" w14:textId="77777777" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00B614FB"><w:pPr><w:pStyle w:val="Heading3"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Use the subject line: "Partial Data Deletion Request – [Your Registered Email ID]"</w:t></w:r></w:p><w:p w14:paraId="4BBC5456" w14:textId="77777777" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00B614FB"><w:pPr><w:pStyle w:val="Heading3"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Clearly identify the types of data you wish to have removed</w:t></w:r></w:p><w:p w14:paraId="150E5395" w14:textId="7185FDF4" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="007136B2"><w:pPr><w:pStyle w:val="Heading2"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00B614FB"><w:rPr><w:u w:val="single"/><w:lang w:val="en-US"/></w:rPr><w:t>Verification</w:t></w:r><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t xml:space="preserve">. </w:t></w:r><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>All partial data deletion requests will be subject to identity verification.</w:t></w:r></w:p><w:p w14:paraId="1F6F8587" w14:textId="55897118" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00942CC4"><w:pPr><w:pStyle w:val="Heading2"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00B614FB"><w:rPr><w:u w:val="single"/><w:lang w:val="en-US"/></w:rPr><w:t>Processing</w:t></w:r><w:r w:rsidRPr="00B614FB"><w:rPr><w:u w:val="single"/><w:lang w:val="en-US"/></w:rPr><w:t>.</w:t></w:r><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Once verified, we will process your request within a reasonable time</w:t></w:r><w:r><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>or as required under applicable laws in accordance with applicable legal requirements.</w:t></w:r></w:p><w:p w14:paraId="18B87CA7" w14:textId="1E455F09" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00495B58"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r w:rsidRPr="00495B58"><w:t>Data Retention</w:t></w:r></w:p><w:p w14:paraId="7892E1F0" w14:textId="77777777" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00495B58"><w:pPr><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Even after a deletion request, certain information may be retained where required or permitted by law, such as:</w:t></w:r></w:p><w:p w14:paraId="3C01E670" w14:textId="77777777" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00495B58"><w:pPr><w:pStyle w:val="Heading2"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Transaction records, invoices, and billing data (retained as per statutory obligations)</w:t></w:r></w:p><w:p w14:paraId="765F7DB1" w14:textId="77777777" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00495B58"><w:pPr><w:pStyle w:val="Heading2"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Information necessary for fraud prevention, legal claims, or regulatory compliance</w:t></w:r></w:p><w:p w14:paraId="0612C2AF" w14:textId="77777777" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00495B58"><w:pPr><w:pStyle w:val="Heading2"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Data stored in backup systems, which will be purged as part of our regular data retention cycle</w:t></w:r></w:p><w:p w14:paraId="1DA834A0" w14:textId="77777777" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00D12244"><w:pPr><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Such data will be retained only for the duration necessary and as permitted under applicable data protection and record-keeping laws.</w:t></w:r></w:p><w:p w14:paraId="30EC40D4" w14:textId="77777777" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00495B58"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r w:rsidRPr="00495B58"><w:t>Need Assistance?</w:t></w:r></w:p><w:p w14:paraId="727FD0B1" w14:textId="77777777" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00495B58"><w:pPr><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>If you have any questions or concerns about your data or privacy rights, please reach out to our Privacy Team:</w:t></w:r></w:p><w:p w14:paraId="462B0890" w14:textId="3629114E" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00495B58"><w:pPr><w:pStyle w:val="Heading2"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t xml:space="preserve">Email: </w:t></w:r><w:hyperlink r:id="rId13" w:history="1"><w:r w:rsidR="008B1AEB" w:rsidRPr="003B0490"><w:rPr><w:rStyle w:val="Hyperlink"/></w:rPr><w:t>info@damndeal.in</w:t></w:r></w:hyperlink><w:r w:rsidR="008B1AEB"><w:t xml:space="preserve"> </w:t></w:r></w:p><w:p w14:paraId="67CAC5A4" w14:textId="77777777" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00495B58"><w:pPr><w:pStyle w:val="Heading2"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Phone: +91-76968-27211</w:t></w:r></w:p><w:p w14:paraId="337A95AE" w14:textId="1880C649" w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidRDefault="00495B58" w:rsidP="00495B58"><w:pPr><w:pStyle w:val="Heading2"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r w:rsidRPr="00495B58"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t xml:space="preserve">Website: </w:t></w:r><w:hyperlink r:id="rId14" w:history="1"><w:r w:rsidR="008B1AEB" w:rsidRPr="003B0490"><w:rPr><w:rStyle w:val="Hyperlink"/><w:lang w:val="en-US"/></w:rPr><w:t>www.damndeal.in</w:t></w:r></w:hyperlink><w:r w:rsidR="008B1AEB"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r></w:p><w:sectPr w:rsidR="00495B58" w:rsidRPr="00495B58" w:rsidSect="00A6612F"><w:footerReference w:type="default" r:id="rId15"/><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1134" w:right="1134" w:bottom="1134" w:left="1134" w:header="709" w:footer="709" w:gutter="0"/><w:cols w:space="708"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>
