# ════════════════════════════════════════════════════════════════════
#  DamnDeal — Local Environment Configuration
# ════════════════════════════════════════════════════════════════════
#  Copy this file to `.env` (in the SAME folder as src/) and fill values.
#  In production this file lives at /var/www/damndeal/.env
#
#  Most operational settings (Fast2SMS, Razorpay, branding, contact
#  numbers, legal pages, logos, etc.) are managed from the ADMIN PANEL
#  at runtime — NOT from this file. Env vars below are only used as
#  *fallbacks* if the AppSettings collection is empty.
# ════════════════════════════════════════════════════════════════════


# ── Server ──────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development


# ── MongoDB (REQUIRED) ──────────────────────────────────────────────
# Local dev:   mongodb://localhost:27017/damndeal
# Docker:      mongodb://damndeal:secret@mongo:27017/damndeal?authSource=admin
MONGO_URI=mongodb://localhost:27017/damndeal


# ── Redis (REQUIRED for OTP rate-limit / sessions) ──────────────────
REDIS_URL=redis://localhost:6379


# ── JWT (REQUIRED — generate random 64-char strings) ────────────────
# Quick generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_to_a_random_64_char_string
JWT_REFRESH_SECRET=CHANGE_ME_to_another_random_64_char_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d


# ════════════════════════════════════════════════════════════════════
#  SETTINGS ENCRYPTION KEY (★ REQUIRED for production ★)
# ════════════════════════════════════════════════════════════════════
#  All sensitive AppSettings values (Fast2SMS API key, Razorpay secret,
#  Delhivery/FShip tokens, etc.) are encrypted at rest with AES-256-GCM
#  using this key. Without it, sensitive values fall back to PLAINTEXT
#  storage (a warning is logged on first save).
#
#  Generate ONCE and never change (changing the key makes all existing
#  encrypted values unreadable). Store securely.
#  Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ════════════════════════════════════════════════════════════════════
SETTINGS_ENCRYPTION_KEY=CHANGE_ME_to_a_random_64_char_hex_string


# ── CORS — comma-separated allowed origins ──────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002


# ════════════════════════════════════════════════════════════════════
#  ADMIN PANEL ACCESS  (★ READ THIS ★)
# ════════════════════════════════════════════════════════════════════
#  Admin login uses **phone + OTP** (same as user app), but only the
#  numbers listed here are allowed to receive an admin OTP.
#
#  HOW TO ADD A NEW ADMIN NUMBER:
#    1. Add the 10-digit phone (no +91, no spaces) below — comma-separated.
#       Example: ADMIN_PHONES=9876543210,9123456780
#    2. Restart the backend:  pm2 restart damndeal-api
#       (local dev: just restart `npm run dev`)
#    3. Open https://your-domain/admin → enter that phone → receive OTP
#       → login. A User document with role=admin is auto-created on first
#       successful login.
#    4. To REMOVE an admin: delete their phone from this list AND delete
#       their user doc:  db.users.deleteOne({phone:"9876543210", role:"admin"})
#
#  SECURITY: If this list is EMPTY, ANY phone can request an admin OTP —
#  set at least one number before deploying to production.
# ════════════════════════════════════════════════════════════════════
ADMIN_PHONES=9876543210


# ── Dev/Test OTP bypass (NEVER set in production) ───────────────────
# Phones listed here will accept the fixed TEST_OTP without sending real SMS.
# Useful for local dev so you don't burn Fast2SMS credits.
TEST_PHONES=9876543210,9123456780
TEST_OTP=123456


# ════════════════════════════════════════════════════════════════════
#  Fast2SMS (WhatsApp transactional messages) — OPTIONAL
# ════════════════════════════════════════════════════════════════════
#  Recommended: leave these BLANK and configure from Admin Panel
#  → Settings → 💚 WhatsApp/Fast2SMS  (so non-developers can update keys
#  without touching the server). Values below are used only as fallback
#  when the corresponding AppSettings row is empty.
#
#  Get these from https://www.fast2sms.com → Dashboard → WhatsApp:
#    - API key:           Account → API key
#    - Phone Number ID:   WhatsApp → My Numbers → (your approved sender)
#    - Message IDs:       WhatsApp → Templates → (after approval, 5-digit ID)
# ════════════════════════════════════════════════════════════════════
FAST2SMS_API_KEY=
FAST2SMS_PHONE_NUMBER_ID=
FAST2SMS_MESSAGE_ID=                  # OTP template message ID
FAST2SMS_TPL_ORDER_CONFIRM=           # Order placed
FAST2SMS_TPL_ON_THE_WAY=              # Order shipped/out for delivery
FAST2SMS_TPL_ORDER_CANCEL=            # Order cancelled


# ════════════════════════════════════════════════════════════════════
#  Razorpay (payments) — configure from Admin Panel preferred
# ════════════════════════════════════════════════════════════════════
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


# ── Misc ────────────────────────────────────────────────────────────
REFUND_DAYS=5-7
# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://damndeal:damndeal_secret@mongo:27017/damndeal?authSource=admin
MONGO_USER=damndeal
MONGO_PASS=damndeal_secret

# Redis
REDIS_URL=redis://:redis_secret@redis:6379
REDIS_PASS=redis_secret

# JWT
JWT_SECRET=CHANGE_ME_to_a_random_64_char_string
JWT_REFRESH_SECRET=CHANGE_ME_to_another_random_64_char_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# SMS Provider (uncomment and fill when ready)
# TWILIO_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE=+1234567890

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email / SMTP (uncomment when ready)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# FROM_EMAIL=noreply@damndeal.in
