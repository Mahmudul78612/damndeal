# ── Server ──
PORT=6000
NODE_ENV=development

# ── MongoDB ──
MONGO_URI=mongodb://localhost:27017/roadhustler

# ── JWT (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ──
JWT_SECRET=CHANGE_ME_random_64_char_string
JWT_REFRESH_SECRET=CHANGE_ME_another_random_64_char_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── CORS (comma-separated frontend origins) ──
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Seed owner/admin (created on `npm run seed`) ──
SEED_ADMIN_EMAIL=info@road-hustlers.com
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_password
SEED_ADMIN_NAME=Road Hustlers Admin

# ── Stripe (online customer payments) ──
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# ── Email (SMTP for invoices/estimates) — optional for now ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=info@road-hustlers.com
