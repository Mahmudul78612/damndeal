# ── Server ──
PORT=7000
NODE_ENV=development
PUBLIC_URL=http://localhost:7000

# ── MongoDB ──
MONGO_URI=mongodb://localhost:27017/adsservices

# ── JWT ── (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=CHANGE_ME_random_64_char_string
JWT_REFRESH_SECRET=CHANGE_ME_another_random
JWT_ACCESS_EXPIRY=30m
JWT_REFRESH_EXPIRY=30d

# ── CORS — comma-separated frontend/app origins (serve API is open to all) ──
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Seed admin ──
SEED_ADMIN_EMAIL=admin@adsservices.com
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_password
SEED_ADMIN_NAME=Ads Admin
